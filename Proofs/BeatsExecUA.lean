/-- `k` as an index: the method parameter `k` is cell 2 (variable `nv + 2`), `x` is cell 3, the members `inf`, `n` are cells 0, 1. -/
abbrev bIx (nv : Nat) : NExpr := .cast u64 (.variable i32 (nv + 2))
abbrev bX (nv : Nat) : NExpr := .variable s64 (nv + 3)
abbrev bInf (nv : Nat) : NExpr := .variable s64 nv
abbrev bNInf (nv : Nat) : NExpr := .unary s64 .neg (.variable s64 nv)
abbrev bLenK (nv : Nat) : NExpr := .read s64 (.local 6) (bIx nv)
abbrev bZero : NExpr := .cast s64 (.literal i32 0)
abbrev bW (v : Nat) (e : NExpr) (nv : Nat) : Command := .primitive (.write (.local v) s64 (bIx nv) e)

abbrev UA (nv : Nat) : Command :=
  .sequence (bW 0 (bX nv) nv) (.sequence (bW 1 (bNInf nv) nv) (.sequence (bW 3 (bX nv) nv) (.sequence (bW 4 (bInf nv) nv)
  (.sequence (bW 2 (bLenK nv) nv) (.sequence (bW 5 (bLenK nv) nv) (.sequence (bW 8 (bX nv) nv) (.sequence (bW 7 bZero nv) Sk)))))))

def uaB (b : BS) (inf x : Int) (k : Nat) : BS :=
  { b with
    mxv := b.mxv.set k x
    smx := b.smx.set k (-inf)
    mnv := b.mnv.set k x
    smn := b.smn.set k inf
    mxc := b.mxc.set k (b.len.getD k 0)
    mnc := b.mnc.set k (b.len.getD k 0)
    lval := b.lval.set k x
    ladd := b.ladd.set k 0 }


theorem ua_exec (mv : MV) (hnv : mv.nv = 15) (pre : List Cell) (hty : ∀ v, v < 9 → mv.ty v = s64) (b : BS) (P : List Cell)
    (inf x : Int) (n k : Nat) (hk : k < M31) (hinf : s64.valid inf = true) (hninf : s64.valid (-inf) = true)
    (hx : s64.valid x = true) (hl0 : k < b.mxv.length) (hl1 : k < b.smx.length) (hl2 : k < b.mxc.length)
    (hl3 : k < b.mnv.length) (hl4 : k < b.smn.length) (hl5 : k < b.mnc.length) (hl6 : k < b.len.length)
    (hl7 : k < b.ladd.length) (hl8 : k < b.lval.length) (hlenv : s64.valid (b.len.getD k 0) = true)
    (hlenL : ∀ w ∈ b.len, s64.valid w = true) (fu : Nat) :
    ∃ r : PRM, pexecM mv fu (UA (mv.nv + pre.length)) (gS P (pre ++ [cs inf, ci n, ci k, cs x])) (VVB b) = some r ∧ r.ret = none ∧
      r.ps = gS P (pre ++ [cs inf, ci n, ci k, cs x]) ∧ r.vv = VVB (uaB b inf x k) ∧ r.cost ≤ 1000 ∧ r.need ≤ P.length + 2 * pre.length + 108 ∧ r.wk ≤ 8 := by
  have E0 : penvN mv.nv (gS P (pre ++ [cs inf, ci n, ci k, cs x])) (mv.nv + pre.length) s64 = some inf := by
    have := envs mv P (pre ++ [cs inf, ci n, ci k, cs x]) pre.length (cs inf) (by simp) hinf
    simpa using this
  have E2 := envs mv P (pre ++ [cs inf, ci n, ci k, cs x]) (pre.length + 2) (ci k) (by simp [List.getElem?_append_right]) (Proofs.BellmanFordExec.i32_valid_nat k hk)
  have E3 := envs mv P (pre ++ [cs inf, ci n, ci k, cs x]) (pre.length + 3) (cs x) (by simp [List.getElem?_append_right]) hx
  have hId : ∀ vv : Nat → List Int, vdenM mv vv (penvN mv.nv (gS P (pre ++ [cs inf, ci n, ci k, cs x]))) (rdIdx (mv.nv + pre.length) 2) = some (k : Int) := by
    intro vv; rw [vdenM_scalar _ _ _ _ rfl]; exact cidx_den _ (mv.nv + pre.length + 2) k E2 hk
  have hXd : ∀ vv : Nat → List Int, vdenM mv vv (penvN mv.nv (gS P (pre ++ [cs inf, ci n, ci k, cs x]))) (bX (mv.nv + pre.length)) = some x := by
    intro vv; rw [vdenM_scalar _ _ _ _ rfl, den_variable]; exact E3
  have hInfd : ∀ vv : Nat → List Int, vdenM mv vv (penvN mv.nv (gS P (pre ++ [cs inf, ci n, ci k, cs x]))) (bInf (mv.nv + pre.length)) = some inf := by
    intro vv; rw [vdenM_scalar _ _ _ _ rfl, den_variable]; exact E0
  have hNd : ∀ vv : Nat → List Int, vdenM mv vv (penvN mv.nv (gS P (pre ++ [cs inf, ci n, ci k, cs x]))) (bNInf (mv.nv + pre.length)) = some (-inf) := by
    intro vv
    rw [vdenM_scalar _ _ _ _ rfl, Proofs.BellmanFordPExec.den_unaryP, den_variable, E0, Option.bind_some]
    exact conv_signed s64 rfl rfl _ hninf
  have hZd : ∀ vv : Nat → List Int, vdenM mv vv (penvN mv.nv (gS P (pre ++ [cs inf, ci n, ci k, cs x]))) bZero = some 0 := by
    intro vv
    rw [vdenM_scalar _ _ _ _ rfl, den_cast, den_literal, if_pos (show i32.valid 0 = true from rfl), Option.bind_some]
    exact conv_signed s64 rfl rfl _ rfl
  have hLd : ∀ (vv : Nat → List Int), vv 6 = b.len → vdenM mv vv (penvN mv.nv (gS P (pre ++ [cs inf, ci n, ci k, cs x]))) (bLenK (mv.nv + pre.length)) = some (b.len.getD k 0) := by
    intro vv h6
    exact rdM_val mv vv (penvN mv.nv (gS P (pre ++ [cs inf, ci n, ci k, cs x]))) 6 (by omega) s64 (hty 6 (by omega)).symm (rdIdx (mv.nv + pre.length) 2) rfl rfl k
      (cidx_den _ (mv.nv + pre.length + 2) k E2 hk) (b.len.getD k 0) (by rw [h6]; exact vec_getI b.len k hl6)
      (by rw [hty 6 (by omega)]; exact hlenv)
