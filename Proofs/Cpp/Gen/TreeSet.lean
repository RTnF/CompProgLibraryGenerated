def cp.TreeSet.op_assign_copy {T : Type} [Inhabited T] (self : (cp.TreeSet T)) (other : (cp.TreeSet T)) : Cpp.M ((cp.TreeSet T) × (cp.TreeSet T)) := do
  Cpp.tick
  let mut slots := self.slots
  let mut root := self.root
  let mut free_head := self.free_head
  let t1 ← cp.TreeSet.init
  let mut copy : (cp.TreeSet T) := t1
  let t2 ← cp.TreeSet.copy_contents copy other
  copy := t2
  let t3 ← cp.TreeSet.swap_contents (⟨slots, root, free_head⟩ : (cp.TreeSet T)) copy
  copy := t3.1
  slots := t3.2.slots
  root := t3.2.root
  free_head := t3.2.free_head
  return ((⟨slots, root, free_head⟩ : (cp.TreeSet T)), (⟨slots, root, free_head⟩ : (cp.TreeSet T)))

