  let t1 ← cp.TreeSet.insert (⟨slots, root, free_head⟩ : (cp.TreeSet T)) root key
  slots := t1.2.slots
  root := t1.2.root
  free_head := t1.2.free_head
  root := t1.1
  return (⟨slots, root, free_head⟩ : (cp.TreeSet T))

