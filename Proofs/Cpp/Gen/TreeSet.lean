def cp.TreeSet.rank {T : Type} [Inhabited T] [LT T] [DecidableLT T] (self : (cp.TreeSet T)) (key : T) : Cpp.M (Int × Int) := do
  Cpp.tick
  let slots := self.slots
  let root := self.root
  let free_head := self.free_head
  let mut index : UInt64 := root
  let mut before : UInt64 := (0 : UInt64)
  for _ in Cpp.forever do
    Cpp.tick
    let t1 ← cp.TreeSet.none (T := T)
    if !(decide (index ≠ t1)) then break
    let t2 ← Cpp.optionalValue (Cpp.get slots (Cpp.toSigned 64 index.toNat)).key
    if (decide (key < t2)) then
      index := (Cpp.get slots (Cpp.toSigned 64 index.toNat)).left
    else
      let t3 ← Cpp.optionalValue (Cpp.get slots (Cpp.toSigned 64 index.toNat)).key
      if (decide (t3 < key)) then
        let t4 ← cp.TreeSet.subtree_size (⟨slots, root, free_head⟩ : (cp.TreeSet T)) (Cpp.get slots (Cpp.toSigned 64 index.toNat)).left
        before := (before + ((1 : UInt64) + t4))
        index := (Cpp.get slots (Cpp.toSigned 64 index.toNat)).right
      else
        let t5 ← cp.TreeSet.subtree_size (⟨slots, root, free_head⟩ : (cp.TreeSet T)) (Cpp.get slots (Cpp.toSigned 64 index.toNat)).left
        let mut first : UInt64 := (before + t5)
        return ((Cpp.toSigned 32 first.toNat), (Cpp.toSigned 32 (first + (1 : UInt64)).toNat))
  return ((-1), (-1))

def cp.TreeSet.get_kth {T : Type} [Inhabited T] (self : (cp.TreeSet T)) (position : UInt64) : Cpp.M T := do
  Cpp.tick
  let slots := self.slots
  let root := self.root
  let free_head := self.free_head
  let mut position := position
  let t1 ← cp.TreeSet.subtree_size (⟨slots, root, free_head⟩ : (cp.TreeSet T)) root
  Cpp.check (decide (position < t1))
  let mut index : UInt64 := root
  for _ in Cpp.forever do
    Cpp.tick
    let t2 ← cp.TreeSet.subtree_size (⟨slots, root, free_head⟩ : (cp.TreeSet T)) (Cpp.get slots (Cpp.toSigned 64 index.toNat)).left
    let mut left_size : UInt64 := t2
    if (decide (position < left_size)) then
      index := (Cpp.get slots (Cpp.toSigned 64 index.toNat)).left
    else
      if (decide (position = left_size)) then
        let t3 ← Cpp.optionalValue (Cpp.get slots (Cpp.toSigned 64 index.toNat)).key
        return t3
      else
        position := (position - (left_size + (1 : UInt64)))
        index := (Cpp.get slots (Cpp.toSigned 64 index.toNat)).right
  failure

def cp.TreeSet.find_lower {T : Type} [Inhabited T] [LT T] [DecidableLT T] (self : (cp.TreeSet T)) (key : T) : Cpp.M (Option T) := do
  Cpp.tick
  let slots := self.slots
  let root := self.root
  let free_head := self.free_head
  let mut index : UInt64 := root
  let t1 ← cp.TreeSet.none (T := T)
  let mut candidate : UInt64 := t1
  for _ in Cpp.forever do
    Cpp.tick
    let t2 ← cp.TreeSet.none (T := T)
    if !(decide (index ≠ t2)) then break
    let t3 ← Cpp.optionalValue (Cpp.get slots (Cpp.toSigned 64 index.toNat)).key
    if (decide (key < t3)) then
      index := (Cpp.get slots (Cpp.toSigned 64 index.toNat)).left
    else
      candidate := index
      index := (Cpp.get slots (Cpp.toSigned 64 index.toNat)).right
  let t4 ← cp.TreeSet.none (T := T)
  if (decide (candidate = t4)) then
    return (_root_.Option.none : (Option T))
  let t5 ← Cpp.optionalValue (Cpp.get slots (Cpp.toSigned 64 candidate.toNat)).key
  return (some t5)

