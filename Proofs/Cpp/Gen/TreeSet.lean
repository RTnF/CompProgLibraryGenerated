      slots := (Cpp.set slots (Cpp.toSigned 64 i.toNat) { (Cpp.get slots (Cpp.toSigned 64 i.toNat)) with first := (Cpp.get other.slots (Cpp.toSigned 64 i.toNat)).first })
      slots := (Cpp.set slots (Cpp.toSigned 64 i.toNat) { (Cpp.get slots (Cpp.toSigned 64 i.toNat)) with last := (Cpp.get other.slots (Cpp.toSigned 64 i.toNat)).last })
      i := (i + 1)
  return (⟨slots, root, free_head⟩ : (cp.TreeSet T))

def cp.TreeSet.swap_contents {T : Type} (self : (cp.TreeSet T)) (other : (cp.TreeSet T)) : Cpp.M ((cp.TreeSet T) × (cp.TreeSet T)) := do
  Cpp.tick
  let mut slots := self.slots
  let mut root := self.root
  let mut free_head := self.free_head
  let mut other := other
  let t1 := slots
  slots := other.slots
  other := { other with slots := t1 }
  Cpp.tick
  let mut old_root : UInt64 := root
  let mut old_free : UInt64 := free_head
  root := other.root
  free_head := other.free_head
  other := { other with root := old_root }
  other := { other with free_head := old_free }
  return (other, (⟨slots, root, free_head⟩ : (cp.TreeSet T)))

