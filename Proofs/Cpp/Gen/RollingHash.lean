def cp.SimpleRollingHash.match_custom_vector {T : Type} [Inhabited T] [Cpp.Conv T Int] (self : cp.SimpleRollingHash) (t : (Array T)) (idx : (Array Int)) : Cpp.M UInt64 := do
  Cpp.tick
  let hash_sum_ := self.hash_sum_
