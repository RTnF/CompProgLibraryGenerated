def cp.SimpleRollingHash.match_vector {T : Type} [Inhabited T] [Cpp.Conv T Int] (self : cp.SimpleRollingHash) (t : (Array T)) : Cpp.M UInt64 := do
  Cpp.tick
  let hash_sum_ := self.hash_sum_
  let pows := self.pows
  let n_ := self.n_
  let mut t := t
  let mut n_t : Int := (Cpp.size t)
  if (decide (n_t > n_)) then
    return cp.RH_NPOS
  let t1 ← cp.SimpleRollingHash.hash_all (T := T) (⟨hash_sum_, pows, n_⟩ : cp.SimpleRollingHash) t
  let mut h_t : UInt64 := t1
  let mut last : Int := (n_ - n_t)
  for i in (Cpp.range 0 (last + 1)) do
    Cpp.tick
    let mut index : Int := i
    let t2 ← cp.SimpleRollingHash.hash_int_int (⟨hash_sum_, pows, n_⟩ : cp.SimpleRollingHash) index (index + n_t)
    if (decide (t2 = h_t)) then
      return (UInt64.ofInt i)
  return cp.RH_NPOS

