  let mut h_node := self.h_node
  let mut node := self.node
  let mut lazy := self.lazy
  let mut r := r
  Cpp.check ((decide (0 ≤ r)) && (decide (r ≤ n)))
  let t1 ← Cpp.StaticCall.call (name := "e") (T := M) (R := M)
  let t2 ← Cpp.Invoke1.call (A := M) (R := Bool) f t1
  Cpp.check t2
  if (decide (r = 0)) then
    return (0, (⟨n, n_node, h_node, node, lazy⟩ : (cp.LazySegmentTree M F)))
  r := (r + n_node)
  for i in (Cpp.rangeDown 1 h_node) do
    Cpp.tick
    let t3 ← cp.LazySegmentTree.push (⟨n, n_node, h_node, node, lazy⟩ : (cp.LazySegmentTree M F)) (Cpp.shr (r - 1) i)
    n := t3.n
    n_node := t3.n_node
    h_node := t3.h_node
    node := t3.node
    lazy := t3.lazy
  let t4 ← Cpp.StaticCall.call (name := "e") (T := M) (R := M)
  let mut sm : M := t4
  for _ in Cpp.forever do
    Cpp.tick
    r := (r - 1)
    for _ in Cpp.forever do
      Cpp.tick
      if !((decide (r > 1)) && (decide ((Cpp.mod r 2) ≠ 0))) then break
      r := (Cpp.shr r 1)
    let t5 ← Cpp.AdlCall2.call (name := "op") (A := M) (B := M) (R := M) (Cpp.get node r) sm
    let t6 ← Cpp.Invoke1.call (A := M) (R := Bool) f t5
    if (!t6) then
      for _ in Cpp.forever do
        Cpp.tick
        if !(decide (r < n_node)) then break
        let t7 ← cp.LazySegmentTree.push (⟨n, n_node, h_node, node, lazy⟩ : (cp.LazySegmentTree M F)) r
        n := t7.n
        n_node := t7.n_node
        h_node := t7.h_node
        node := t7.node
        lazy := t7.lazy
        r := ((r * 2) + 1)
        let t8 ← Cpp.AdlCall2.call (name := "op") (A := M) (B := M) (R := M) (Cpp.get node r) sm
        let t9 ← Cpp.Invoke1.call (A := M) (R := Bool) f t8
        if t9 then
          let t10 ← Cpp.AdlCall2.call (name := "op") (A := M) (B := M) (R := M) (Cpp.get node r) sm
          sm := t10
          r := (r - 1)
      return (((r + 1) - n_node), (⟨n, n_node, h_node, node, lazy⟩ : (cp.LazySegmentTree M F)))
    let t11 ← Cpp.AdlCall2.call (name := "op") (A := M) (B := M) (R := M) (Cpp.get node r) sm
    sm := t11
    if !(decide ((Cpp.land r (-r)) ≠ r)) then break
  return (0, (⟨n, n_node, h_node, node, lazy⟩ : (cp.LazySegmentTree M F)))

